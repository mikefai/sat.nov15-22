{
  "name": "sat-1400-courseware",
  "private": true,
  "version": "1.0.0",
  "description": "Digital SAT 1400+ Interactive Courseware & Daily Workbook for International Students",
  "type": "module",
  "scripts": {
    "compile:course": "node scripts/compile-course.mjs",
    "test": "npm run compile:course && node scripts/verify-webapp.mjs",
